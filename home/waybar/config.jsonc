{
	"layer": "top",
	"height": 24,
	"reload_style_on_change": true,
	"modules-left": [ "sway/workspaces" ],
	"modules-right": [ "tray", "network", "pulseaudio", "battery", "clock" ],

	"sway/workspaces": {
		"format": "{icon}",
		"format-icons": { "1": "I.", "2": "II.", "3": "III.", "4": "IV." },
		"on-click-right": "tofi-drun --drun-launch=true"
	},

	"tray": { "icon-size": 13 },

	"network": {
		"format-wifi": "󰤨   {essid}",
		"format-ethernet": "󰈀   {ifname}",
		"format-disconnected": "󰤭   Off",
		"max-length": 25,
		"tooltip": false
	},

	"pulseaudio": {
		"format": "{icon} {volume}%",
		"format-muted": " ",
		"format-icons": {
			"headphone": "  ",
			"default": [" ", "  "]
		}
	},

	"battery": {
		"format": "{icon}  {capacity}%",
		"format-icons": ["  ", "  ", "  ", "  ", "  "],
		"on-click": "${XDG_CONFIG_HOME:-$HOME/.config}/tofi/powermenu.sh"
	},

	"clock": { "format": "{:%a %d %b  %I:%M %p}", "tooltip": false }
}
